# OpenAI-compatible Chat Completions endpoint; choose a model supporting this protocol.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# DeepSeek example: https://api.deepseek.com/v1 and your requested compatible model.
# Disable hidden thinking so no reasoning fields need to be retained or replayed:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
